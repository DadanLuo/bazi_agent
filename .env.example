# 环境变量配置

# 通义千问 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_API_KEY=${DASHSCOPE_API_KEY}
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.5-plus
QWEN_MODEL=qwen3.5-plus
LLM_MAX_TOKENS=16384
MAX_TOKENS=16384
LLM_CONTEXT_WINDOW=262144
LLM_TIMEOUT=120
REQUEST_TIMEOUT=120

# RAG / Embedding
CHROMA_PERSIST_DIR=./knowledge_base/vector_store
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_COLLECTION_PREFIX=bazi_knowledge
RAG_INDEX_VERSION=v2
RAG_SPLITTER_NAME=recursive
RAG_SPLITTER_VERSION=v1

# 日志级别
LOG_LEVEL=INFO

# 服务配置
HOST=0.0.0.0
PORT=8000
